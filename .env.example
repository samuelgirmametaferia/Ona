# ===========================================
# Loadforge — Environment variables
# Copy to .env.local and fill in values.
# See KEYS_AND_TOKENS.md for where to get each key.
# ===========================================

# --- Supabase (supabase.com → Project → Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- Lemon Squeezy (app.lemonsqueezy.com → Settings → API & Webhooks) ---
# Required for checkout and subscription management.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_ID_PRO=
LEMONSQUEEZY_VARIANT_ID_AGENCY=
LEMONSQUEEZY_WEBHOOK_SECRET=

# --- App ---
# In production, set to your live URL (e.g. https://loadforge.org). Required for auth redirects and Lemon Squeezy success URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Optional: support email shown on /contact ---
# NEXT_PUBLIC_SUPPORT_EMAIL=support@loadforge.org

# --- Optional: welcome email (Resend) — sent after signup when set ---
# RESEND_API_KEY=re_...
# RESEND_FROM=Loadforge <noreply@loadforge.org>   (use your verified domain; unverified defaults to onboarding@resend.dev)
# SEND_WELCOME_SECRET=   (optional; if set, POST /api/send-welcome requires header X-Send-Welcome-Secret)

# --- Optional: Upstash Redis (for rate limiting on Vercel) ---
# Without these, rate limiting uses in-memory store (resets per instance). For production on Vercel, create a Redis database at upstash.com and set:
# UPSTASH_REDIS_REST_URL=https://...upstash.io
# UPSTASH_REDIS_REST_TOKEN=...
